<?xml version="1.0" encoding="utf-8" standalone="no" ?>
<!--
    MegaPatch: IBC 1000 l z olejem napedowym.
    Model/kolizje: bazowy IBC z gry (data/objects/pallets/liquidTank), nowa tekstura (czarny zbiornik UV + etykieta DIESEL / UN 1202).
    Cena w sklepie jest dynamiczna: kaucja za pojemnik + 1000 l * aktualna cena diesla (FuelMarket.lua).
-->
<vehicle type="pallet">
    <storeData>
        <name>$l10n_megaPatch_ibcDiesel_name</name>
        <functions>
            <function>$l10n_megaPatch_ibcDiesel_function</function>
        </functions>
        <specs>
            <capacity>1000</capacity>
            <fillTypes>diesel</fillTypes>
            <weight ignore="true"/>
        </specs>
        <image>objects/ibcDiesel/store_ibcDiesel.png</image>
        <!-- wartosc startowa, nadpisywana dynamicznie w grze -->
        <price>1685</price>
        <allowLeasing>false</allowLeasing>
        <canBeSold>false</canBeSold>
        <showInStore>true</showInStore>
        <rotation>0</rotation>
        <shopHeight>2</shopHeight>
        <brand>NONE</brand>
        <category>ibc dieselTanks</category>
        <financeCategory>PURCHASE_FUEL</financeCategory>
        <vertexBufferMemoryUsage>54784</vertexBufferMemoryUsage>
        <indexBufferMemoryUsage>18176</indexBufferMemoryUsage>
        <textureMemoryUsage>458752</textureMemoryUsage>
        <instanceVertexBufferMemoryUsage>0</instanceVertexBufferMemoryUsage>
        <instanceIndexBufferMemoryUsage>0</instanceIndexBufferMemoryUsage>
        <audioMemoryUsage>0</audioMemoryUsage>
        <storeIconRendering>
            <settings cameraXRot="-15" cameraYRot="25" />
        </storeIconRendering>
    </storeData>

    <base>
        <typeDesc>$l10n_typeDesc_pallet</typeDesc>
        <filename>objects/ibcDiesel/ibcDiesel.i3d</filename>
        <size width="1.35" length="1.35" height="1.55" />
        <input allowed="false"/>
        <canBeReset>false</canBeReset>
        <!-- 1000 l ON (~840 kg) + pusty IBC (~60 kg) -->
        <components maxMass="900">
            <component centerOfMass="0 0.1 0" solverIterationCount="10" mass="60" />
        </components>
        <showInVehicleMenu>false</showInVehicleMenu>
        <mapHotspot available="false" />

        <objectChanges>
            <!-- bez brandingu nawozowego: etykieta DIESEL jest w teksturze -->
            <objectChange node="helmConfiguration"    visibilityActive="false"/>
            <objectChange node="cortevaConfiguration" visibilityActive="false"/>
        </objectChanges>
    </base>

    <fillUnit>
        <fillUnitConfigurations>
            <fillUnitConfiguration>
                <fillUnits removeVehicleIfEmpty="true">
                    <fillUnit unitTextOverride="$l10n_unit_literShort" fillTypes="DIESEL" capacity="1000" startFillType="DIESEL" startFillLevel="1000" ignoreFillLimit="true">
                        <fillRootNode node="0>" />
                    </fillUnit>
                </fillUnits>
            </fillUnitConfiguration>
        </fillUnitConfigurations>
    </fillUnit>

    <!-- Tankowanie maszyn stojacych obok IBC (jak z beczki/stacji). 20 l/s - kompromis miedzy pompa 12V a grywalnoscia -->
    <fillTriggerVehicle triggerNode="fillTrigger" fillUnitIndex="1" litersPerSecond="20"/>

    <dynamicMount triggerNode="dynamicMountTrigger" triggerForceAcceleration="5" additionalMountDistance="1.5" jointTransY="0.11" jointLimitToRotY="true"/>

    <dischargeable requiresTipOcclusionArea="false" />

    <tensionBeltObject>
        <meshNodes>
            <meshNode node="fertilizerTank_vis"/>
        </meshNodes>
    </tensionBeltObject>

    <i3dMappings>
        <i3dMapping id="dynamicMountTrigger" node="0>0|0" />
        <i3dMapping id="fillTrigger" node="0>0|1" />
        <i3dMapping id="floorCollision01" node="0>1|0" />
        <i3dMapping id="floorCollision02" node="0>1|1" />
        <i3dMapping id="helmConfiguration" node="0>2|0" />
        <i3dMapping id="decalHelmLiquidHerbicide" node="0>2|0|0" />
        <i3dMapping id="decalHelmLiquidFertilizer" node="0>2|0|1" />
        <i3dMapping id="cortevaConfiguration" node="0>2|1" />
        <i3dMapping id="fertilizerTank_vis" node="0>3|0" />
        <i3dMapping id="materialHerbicide" node="0>3|1" />
    </i3dMappings>
</vehicle>
